---
// Custom Hero — renders the landing page hero on the index page,
// falls back to Starlight's default Hero on all other pages.
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Hero.astro';

const slug = Astro.locals.starlightRoute?.slug ?? Astro.props.slug ?? '';
const isIndex = slug === '' || slug === 'index';
const base = import.meta.env.BASE_URL;
---

{isIndex ? (
  <div class="hero-landing">
    <div class="hero-gradient" aria-hidden="true">
      <span class="hero-gradient-blob"></span>
    </div>

    <div class="hero-content">
      <!-- 
      <p class="hero-badge">WorkIQ</p> 
      -->
      <h1><span class="text-gradient">Work </span>with tools <br />that work <span class="text-gradient">together </span></h1>
      <h2 class="hero-tagline">
        Get AI tools to work together with one install to rule them all.
      </h2>

      <div class="install-command">
        <span class="install-prompt">$</span>
        <span class="install-text">npm install -g @stuffbucket/workiq-proxy</span>
        <button class="install-copy" onclick="navigator.clipboard.writeText('npm install -g @stuffbucket/workiq-proxy')" title="Copy to clipboard">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
        </button>
      </div>
    </div>

    <div class="hero-actions">
      <a href={`${base}/getting-started/install/`} class="primary">Learn more</a>
      <a href="https://github.com/stuffbucket/workiq-proxy" class="secondary">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        GitHub
      </a>
    </div>

    <!-- xterm goes here -->

    <section class="terminal-window" aria-label="Live terminal">
      <div class="terminal-titlebar">
        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
        <span class="terminal-title">workiq-proxy</span>
      </div>
      <div id="terminal-container">
        <div id="terminal-shell">
          <div class="terminal-gutter" aria-hidden="true"></div>
          <div id="terminal-inner"></div>
          <div class="terminal-gutter" aria-hidden="true"></div>
        </div>
      </div>
      <div id="terminal-offline" class="terminal-offline" hidden>
        <p>Start the proxy to connect:</p>
        <code>workiq-proxy serve</code>
      </div>
    </section>

    <section class="features">
      <div class="feature">
        <span class="feature-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></span>
        <h3>One install</h3>
        <p>Auth, setup, queries, and the MCP server all in a single binary. Nothing else required.</p>
      </div>
      <div class="feature">
        <span class="feature-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg></span>
        <h3>Works everywhere</h3>
        <p>Claude Code, VS Code, Codex, and any MCP-compatible client. One proxy, every assistant.</p>
      </div>
      <div class="feature">
        <span class="feature-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></span>
        <h3>Synthetic tools</h3>
        <p>AI agents have access to synthetic tools that extend their capabilities.</p>
      </div>
      <div class="feature">
        <span class="feature-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg></span>
        <h3>Future-proof</h3>
        <p>Automatically steps aside when Work IQ gains new capabilities.</p>
      </div>
      <div class="feature">
        <span class="feature-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6m0 8v6M2 12h6m8 0h6"/><circle cx="12" cy="12" r="4"/></svg></span><h3>Server mode</h3>
        <p>Run a local OpenAI-compatible server that any app can talk to.</p>
      </div>
      <div class="feature">
        <span class="feature-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></span>
        <h3>Full visibility</h3>
        <p>Use with or without an AI agent with enhanced debugging capabilities.</p>
      </div>
    </section>
<!--
    <section class="quick-steps">
      <h2>Up and running in 3 steps</h2>

      <div class="steps-grid">
        <div class="step">
          <div class="step-num">1</div>
          <div class="step-body">
            <h3>Install</h3>
            <p><code>npm install -g @stuffbucket/workiq-proxy</code></p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">2</div>
          <div class="step-body">
            <h3>Authenticate</h3>
            <p><code>workiq-proxy ask</code> — accepts EULA and signs in via browser.</p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">3</div>
          <div class="step-body">
            <h3>Connect</h3>
            <p>Add the MCP server to your AI assistant's config. Done.</p>
          </div>
        </div>
      </div>
    </section>
    -->
  </div>
) : (
  <Default {...Astro.props}><slot /></Default>
)}

<script>
  // Card spotlight: track mouse position for radial glow
  document.querySelectorAll('.feature').forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const el = card as HTMLElement;
      const rect = el.getBoundingClientRect();
      el.style.setProperty('--spot-x', `${e.clientX - rect.left}px`);
      el.style.setProperty('--spot-y', `${e.clientY - rect.top}px`);
    });
  });

  // Live terminal via xterm.js
  async function initTerminal() {
    const container = document.getElementById('terminal-container');
    const terminalInner = document.getElementById('terminal-inner');
    const offline = document.getElementById('terminal-offline');
    if (!container || !terminalInner) return;

    const { Terminal } = await import('xterm');
    const { FitAddon } = await import('@xterm/addon-fit');
    const { WebLinksAddon } = await import('@xterm/addon-web-links');

    const fitAddon = new FitAddon();

    const term = new Terminal({
      cursorBlink: true,
      fontSize: 13,
      fontFamily: "'SF Mono', 'Fira Code', 'JetBrains Mono', Menlo, Consolas, monospace",
      linkHandler: {
        activate(event: MouseEvent, uri: string) {
          // Prompt links work on plain click; external URLs need Cmd/Ctrl-click (iTerm2 style).
          try {
            const u = new URL(uri);
            if (u.hostname === 'workiq.prompt') {
              event.preventDefault();
              const text = u.searchParams.get('q') || '';
              if (text && ws && ws.readyState === WebSocket.OPEN) {
                ws.send(new TextEncoder().encode(text + '\r'));
              }
              term.focus();
              return;
            }
          } catch { /* not a valid URL, fall through */ }
          if (event.metaKey || event.ctrlKey) {
            window.open(uri, '_blank', 'noopener');
          }
        },
      },
      theme: {
        background: '#0d1117',
        foreground: '#c9d1d9',
        cursor: '#58a6ff',
        selectionBackground: '#264f78',
        black: '#0d1117',
        red: '#ff7b72',
        green: '#7ee787',
        yellow: '#d29922',
        blue: '#58a6ff',
        magenta: '#bc8cff',
        cyan: '#39d353',
        white: '#c9d1d9',
        brightBlack: '#484f58',
        brightRed: '#ffa198',
        brightGreen: '#56d364',
        brightYellow: '#e3b341',
        brightBlue: '#79c0ff',
        brightMagenta: '#d2a8ff',
        brightCyan: '#56d364',
        brightWhite: '#f0f6fc',
      },
      allowTransparency: false,
      scrollback: 500,
      rows: 20,
    });

    term.loadAddon(fitAddon);
    term.loadAddon(new WebLinksAddon((_event: MouseEvent, uri: string) => {
      // Prompt links activate on plain click; external URLs need Cmd/Ctrl-click.
      try {
        const u = new URL(uri);
        if (u.hostname === 'workiq.prompt') {
          const text = u.searchParams.get('q') || '';
          if (text && ws && ws.readyState === WebSocket.OPEN) {
            ws.send(new TextEncoder().encode(text + '\r'));
          }
          term.focus();
          return;
        }
      } catch { /* not a valid URL, fall through */ }
      if (_event.metaKey || _event.ctrlKey) {
        window.open(uri, '_blank', 'noopener');
      }
    }));
    term.open(terminalInner);

    // Fit to the inner terminal box; outer container adds a 4px left/right buffer.
    function fitWithMargin() {
      fitAddon.fit();
    }

    // Update the fake titlebar when /title sets an OSC 0 sequence
    const titleEl = document.querySelector('.terminal-title');
    if (titleEl) {
      term.onTitleChange((title) => { titleEl.textContent = title; });
    }

    // Traffic-light dot behaviors
    const frame = container.closest('.terminal-window') as HTMLElement | null;
    const redDot = document.querySelector('.terminal-dot.red');
    const yellowDot = document.querySelector('.terminal-dot.yellow');
    const greenDot = document.querySelector('.terminal-dot.green');

    if (redDot) {
      (redDot as HTMLElement).style.cursor = 'pointer';
      redDot.addEventListener('click', () => {
        if (ws) { ws.close(); ws = null; }
        connected = false;
        term.clear();
        showOffline();
        if (retryTimer) { clearTimeout(retryTimer); retryTimer = null; }
      });
    }

    let collapsed = false;
    if (yellowDot) {
      (yellowDot as HTMLElement).style.cursor = 'pointer';
      yellowDot.addEventListener('click', () => {
        collapsed = !collapsed;
        container!.style.display = collapsed ? 'none' : '';
        if (offline) offline.style.display = collapsed ? 'none' : '';
        if (!collapsed) requestAnimationFrame(() => fitWithMargin());
      });
    }

    if (greenDot) {
      let expanded = false;
      (greenDot as HTMLElement).style.cursor = 'pointer';
      greenDot.addEventListener('click', () => {
        if (collapsed) {
          collapsed = false;
          container!.style.display = '';
          if (offline) offline.style.display = '';
        }
        expanded = !expanded;
        if (frame) {
          if (expanded) {
            frame.style.position = 'fixed';
            frame.style.inset = '0';
            frame.style.zIndex = '9999';
            frame.style.borderRadius = '0';
            frame.style.margin = '0';
            frame.style.maxWidth = 'none';
            container.style.height = `calc(100vh - ${frame.querySelector('.terminal-titlebar')!.getBoundingClientRect().height}px)`;
          } else {
            frame.style.position = '';
            frame.style.inset = '';
            frame.style.zIndex = '';
            frame.style.borderRadius = '';
            frame.style.margin = '';
            frame.style.maxWidth = '';
            container.style.height = '';
          }
        }
        requestAnimationFrame(() => {
          fitWithMargin();
          if (ws && ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ cols: term.cols, rows: term.rows }));
          }
        });
      });
    }

    // Defer fit until after layout is stable
    requestAnimationFrame(() => fitWithMargin());

    // Try to connect to the local REPL WebSocket
    const wsUrl = 'ws://localhost:11435/v1/repl';
    let ws: WebSocket | null = null;
    let connected = false;
    let retryDelay = 1000;  // start at 1s
    let retryTimer: ReturnType<typeof setTimeout> | null = null;
    const MAX_RETRY_DELAY = 5000; // cap at 5s so page updates quickly when server starts

    function connect() {
      try {
        ws = new WebSocket(wsUrl);
        ws.binaryType = 'arraybuffer';

        ws.onopen = () => {
          connected = true;
          retryDelay = 1000; // reset backoff on success
          if (offline) offline.hidden = true;
          container!.style.display = '';
          console.log('[workiq] connected to REPL at', wsUrl);
          // Send resize immediately so the server spawns the pty at the right size.
          fitWithMargin();
          console.log('[workiq] terminal dimensions:', term.cols, 'x', term.rows);
          if (term.cols > 1) {
            ws!.send(JSON.stringify({ cols: term.cols, rows: term.rows }));
          }
        };

        ws.onmessage = (ev) => {
          const data = ev.data instanceof ArrayBuffer
            ? new Uint8Array(ev.data)
            : ev.data;
          term.write(data);
        };

        ws.onclose = () => {
          if (connected) {
            // Was connected, now lost — clear terminal and reconnect
            connected = false;
            term.clear();
          }
          scheduleRetry();
        };

        ws.onerror = () => {
          // onerror is always followed by onclose — no action needed here
        };
      } catch {
        scheduleRetry();
      }
    }

    function scheduleRetry() {
      showOffline();
      if (retryTimer) return; // already scheduled
      console.log(`[workiq] REPL not available, retrying in ${retryDelay / 1000}s`);
      retryTimer = setTimeout(() => {
        retryTimer = null;
        retryDelay = Math.min(retryDelay * 1.5, MAX_RETRY_DELAY);
        connect();
      }, retryDelay);
    }

    function showOffline() {
      container!.style.display = 'none';
      if (offline) offline.hidden = false;
    }

    // Forward user input to WebSocket
    term.onData((data) => {
      if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(new TextEncoder().encode(data));
      }
    });

    // Handle resize
    const ro = new ResizeObserver(() => {
      fitWithMargin();
      if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ cols: term.cols, rows: term.rows }));
      }
    });
    ro.observe(terminalInner);

    // Auto-focus: when the user starts typing anywhere on the page,
    // focus the terminal so keystrokes go to the REPL.
    document.addEventListener('keydown', (e) => {
      if (!connected) return;
      // Don't steal from inputs, textareas, or contenteditable
      const tag = (e.target as HTMLElement).tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || (e.target as HTMLElement).isContentEditable) return;
      // Don't steal modifier-only combos (Cmd+T, Ctrl+L, etc.)
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      term.focus();
    });

    // Prevent page scroll when mouse is over the terminal
    container.addEventListener('wheel', (e) => { e.preventDefault(); }, { passive: false });

    // When terminal gets focus, scroll the frame into view:
    // show top of frame if it fits, otherwise anchor the bottom.
    if (frame) {
      container.addEventListener('mousedown', () => {
        const rect = frame.getBoundingClientRect();
        if (rect.height <= window.innerHeight) {
          // Whole frame fits — show the top
          frame.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          // Frame taller than viewport — anchor the bottom
          frame.scrollIntoView({ behavior: 'smooth', block: 'end' });
        }
      });
    }

    connect();
  }

  // Only init on index page
  if (document.querySelector('.hero-landing')) {
    initTerminal();
  }
</script>
